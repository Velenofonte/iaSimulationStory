# Azure / OpenAI-compatible (review + ingest)
OPENAI_API_KEY=
LLM_API_BASE_URL=

# OpenRouter (narrativa resolve/render) — modelli con slug "provider/model"
OPENROUTER_API_KEY=
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NARRATIVE=minimax/minimax-m3:free
LLM_MODEL_RESOLVE=minimax/minimax-m3:free
LLM_MODEL_RENDER=minimax/minimax-m3:free

# Gemini (opzionale) — modelli il cui nome inizia con "gemini"
# GEMINI_API_KEY=
# LLM_MODEL_NARRATIVE=gemini-3.8-flash

LLM_MODEL_REVIEW=gpt-4o-mini
LLM_MODEL_INGEST=gpt-4o-mini
PRESENT_REVIEW_EVERY_N=5
CONSOLIDATE_EVERY_N=12
RECENT_CHAT_MESSAGES=8
# Tetto parole sulla prosa Pass 2 (render). 0 = nessun limite.
NARRATIVE_MAX_WORDS=350
# Excerpt world_pages; Gerarchia lore viene anteposta se presente.
WORLD_EXCERPT_CHARS=900
